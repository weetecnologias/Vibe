{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@kit": ["../../packages/backoffice-kit/src/index.ts"],
      "@kit/*": ["../../packages/backoffice-kit/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-router-dom": ["./node_modules/react-router-dom"],
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["src", "../../packages/backoffice-kit/src", "vite.config.ts"]
}
